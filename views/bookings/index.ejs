<% layout("layouts/boilerplate") %>

<div class="row my-4">
	<div class="col-12 col-xl-10 offset-xl-1">
		<!-- Header Banner -->
		<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
			<div>
				<h1 class="editorial-title mb-1" style="font-size: 2.1rem;">My Bookings &amp; Trips</h1>
				<p class="text-muted small mb-0">View, manage, and review your upcoming retreats and past vacation reservations.</p>
			</div>
			<div class="mt-3 mt-md-0">
				<a href="/listings" class="btn btn-forest rounded-pill px-4">
					<i class="fa-solid fa-compass me-1"></i> Explore More Properties
				</a>
			</div>
		</div>

		<% if (!bookings || bookings.length === 0) { %>
			<div class="text-center my-5 py-5 border rounded-4 bg-white shadow-sm" style="border-color: var(--border-color) !important;">
				<div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: var(--forest-50); color: var(--forest-800);">
					<i class="fa-solid fa-suitcase-rolling fa-2x"></i>
				</div>
				<h4 class="fw-bold mb-2">No trips booked yet</h4>
				<p class="text-muted col-md-6 mx-auto mb-4" style="line-height: 1.6;">
					When you reserve an accommodation, your trip details, receipts, and host contact information will appear right here.
				</p>
				<a href="/listings" class="btn btn-forest rounded-pill px-4 py-2">
					Start Exploring Now
				</a>
			</div>
		<% } else { %>
			<div class="row row-cols-1 row-cols-xl-2 g-4">
				<% for (let booking of bookings) { %>
					<% const listing = booking.listing || {}; %>
					<div class="col">
						<div class="trip-card h-100 d-flex flex-column position-relative">
							<div class="row g-0 h-100">
								<!-- Property Media Left -->
								<div class="col-sm-5">
									<div class="trip-img-wrapper">
										<img
											src="<%= listing.image && listing.image.url ? listing.image.url : '/images/listing-placeholder.jpg' %>"
											alt="<%= listing.title %>"
											data-fallback-src="/images/listing-placeholder.jpg"
										/>
									</div>
								</div>

								<!-- Booking Details Right -->
								<div class="col-sm-7 d-flex flex-column min-w-0">
									<div class="p-3 d-flex flex-column h-100">
										<div class="d-flex justify-content-between align-items-start gap-2 mb-1">
											<h5 class="fw-bold text-truncate min-w-0 mb-0" style="font-size: 1.05rem; color: var(--ink-900);" title="<%= listing.title %>">
												<%= listing.title || "Vacation Rental" %>
											</h5>
											<% if (booking.status === 'confirmed') { %>
												<span class="stamp stamp-confirmed flex-shrink-0">
													<i class="fa-solid fa-circle-check"></i> Confirmed
												</span>
											<% } else if (booking.status === 'cancelled') { %>
												<span class="stamp stamp-cancelled flex-shrink-0">
													<i class="fa-solid fa-ban"></i> Cancelled
												</span>
											<% } else { %>
												<span class="stamp stamp-pending flex-shrink-0">
													<%= booking.status %>
												</span>
											<% } %>
										</div>
										<p class="text-muted small text-truncate mb-2">
											<i class="fa-solid fa-location-dot me-1 text-danger"></i>
											<%= listing.location %>, <%= listing.country %>
										</p>

										<div class="stay-info-box my-2 small">
											<div class="d-flex justify-content-between mb-1">
												<span class="text-muted">Check-in:</span>
												<span class="fw-semibold text-dark"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
											</div>
											<div class="d-flex justify-content-between mb-1">
												<span class="text-muted">Check-out:</span>
												<span class="fw-semibold text-dark"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
											</div>
											<div class="d-flex justify-content-between">
												<span class="text-muted">Duration:</span>
												<span><%= booking.totalNights %> night<%= booking.totalNights > 1 ? 's' : '' %> &bull; <%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %></span>
											</div>
										</div>

										<div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top" style="border-color: var(--border-color) !important;">
											<div>
												<span class="text-muted small d-block" style="font-size: 0.72rem;">Total Paid</span>
												<span class="fw-bold fs-5 tabular-nums" style="color: var(--forest-900);">&#x20B9;<%= booking.totalPrice.toLocaleString("en-IN") %></span>
											</div>
											<div class="d-flex flex-wrap gap-1 justify-content-end">
												<% if (booking.payment && (booking.payment.status === 'succeeded' || booking.payment.status === 'refunded')) { %>
													<a href="/payments/receipt/<%= booking.payment._id || booking.payment %>" class="btn btn-sm btn-forest-outline rounded-pill px-2 py-1" style="font-size: 0.75rem;">
														Invoice
													</a>
												<% } else if ((booking.status === 'confirmed' || booking.status === 'pending') && booking.paymentStatus === 'unpaid') { %>
													<a href="/payments/checkout/<%= booking._id %>" class="btn btn-sm btn-forest rounded-pill px-3 py-1" style="font-size: 0.75rem;">
														Pay
													</a>
												<% } %>
												<a href="/bookings/<%= booking._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-2 py-1" style="font-size: 0.75rem;">
													Receipt
												</a>
												<% if (booking.status === 'confirmed' || booking.status === 'pending') { %>
													<form
														action="/bookings/<%= booking._id %>/cancel"
														method="POST"
														data-confirm="Are you sure you want to cancel this reservation?"
														class="d-inline"
													>
														<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
														<button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1" style="font-size: 0.75rem;">
															Cancel
														</button>
													</form>
												<% } %>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				<% } %>
			</div>
		<% } %>
	</div>
</div>
