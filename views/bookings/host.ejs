<% layout("layouts/boilerplate") %>

<div class="row my-4">
	<div class="col-12 col-xl-10 offset-xl-1">
		<!-- Header Banner -->
		<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--border-color) !important;">
			<div>
				<h1 class="editorial-title mb-1" style="font-size: 2.1rem;">Host Reservations</h1>
				<p class="text-muted small mb-0">Track bookings, guest check-ins, and incoming payouts across your listed properties.</p>
			</div>
			<div class="mt-3 mt-md-0">
				<a href="/listings/new" class="btn btn-forest rounded-pill px-4">
					<i class="fa-solid fa-plus me-1"></i> Add New Listing
				</a>
			</div>
		</div>

		<% if (!reservations || reservations.length === 0) { %>
			<div class="text-center my-5 py-5 border rounded-4 bg-white shadow-sm" style="border-color: var(--border-color) !important;">
				<div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: var(--forest-50); color: var(--forest-800);">
					<i class="fa-solid fa-calendar-xmark fa-2x"></i>
				</div>
				<h4 class="fw-bold mb-2">No reservations yet</h4>
				<p class="text-muted col-md-6 mx-auto mb-4" style="line-height: 1.6;">
					When guests reserve your properties, their reservation details, guest profiles, check-in dates, and payouts will appear here.
				</p>
			</div>
		<% } else { %>
			<div class="table-responsive bg-white rounded-4 shadow-sm border p-3" style="border-color: var(--border-color) !important;">
				<table class="table table-hover align-middle mb-0">
					<thead style="background-color: var(--paper-100); border-bottom: 2px solid var(--border-color);">
						<tr>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Property</th>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Guest</th>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Stay Dates</th>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Guests</th>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Total Payout</th>
							<th class="py-3 px-3 fw-semibold small text-muted text-uppercase" style="letter-spacing: 0.05em;">Status</th>
						</tr>
					</thead>
					<tbody>
						<% for (let res of reservations) { %>
							<tr>
								<td class="py-3 px-3">
									<div class="d-flex align-items-center gap-3">
										<img
											src="<%= res.listing && res.listing.image && res.listing.image.url ? res.listing.image.url : '/images/listing-placeholder.jpg' %>"
											alt=""
											class="rounded-3 shadow-sm"
											style="width: 52px; height: 52px; object-fit: cover;"
										/>
										<div>
											<span class="fw-bold d-block text-truncate text-dark" style="max-width: 220px;"><%= res.listing ? res.listing.title : "Deleted Property" %></span>
											<span class="text-muted small"><%= res.listing ? res.listing.location : "" %></span>
										</div>
									</div>
								</td>
								<td class="py-3 px-3">
									<span class="fw-semibold text-dark"><%= res.user ? res.user.username : "Guest" %></span>
									<span class="text-muted small d-block"><%= res.user ? res.user.email : "" %></span>
								</td>
								<td class="py-3 px-3">
									<span class="small d-block fw-medium"><b>In:</b> <%= new Date(res.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
									<span class="small d-block text-muted"><b>Out:</b> <%= new Date(res.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
								</td>
								<td class="py-3 px-3">
									<span class="badge bg-light text-dark border px-2 py-1"><%= res.guests %> guest<%= res.guests > 1 ? 's' : '' %></span>
								</td>
								<td class="py-3 px-3 fw-bold tabular-nums" style="color: var(--forest-900);">&#x20B9;<%= res.totalPrice.toLocaleString("en-IN") %></td>
								<td class="py-3 px-3">
									<% if (res.status === 'confirmed') { %>
										<span class="stamp stamp-confirmed">Confirmed</span>
									<% } else if (res.status === 'cancelled') { %>
										<span class="stamp stamp-cancelled">Cancelled</span>
									<% } else { %>
										<span class="stamp stamp-pending"><%= res.status %></span>
									<% } %>
								</td>
							</tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</div>
</div>
