<% layout("/layouts/boilerplate") %>

<div class="container-standard py-4 my-2">
	<!-- Header & Actions -->
	<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
		<div>
			<h1 class="editorial-title h2 fw-bold mb-1 d-flex align-items-center gap-2 text-dark">
				<i class="fa-solid fa-bell text-forest"></i>
				<span>Notification Center</span>
			</h1>
			<p class="text-muted small mb-0">Stay informed about your reservations, guest inquiries, payments, and property reviews.</p>
		</div>
		<div class="d-flex align-items-center gap-2">
			<% if (unreadCount > 0) { %>
				<form action="/notifications/mark-all-read" method="POST" class="d-inline">
					<button type="submit" class="btn btn-forest-outline btn-sm rounded-pill px-3 shadow-none">
						<i class="fa-solid fa-check-double me-1"></i> Mark All as Read
					</button>
				</form>
			<% } %>
		</div>
	</div>

	<!-- Filter Tabs -->
	<div class="d-flex align-items-center gap-2 mb-4">
		<a href="/notifications?filter=all" class="btn btn-sm rounded-pill px-3 <%= activeFilter === 'all' ? 'btn-forest' : 'btn-forest-outline' %>">
			All Notifications <span class="badge rounded-pill bg-white text-dark ms-1 font-tabular"><%= total %></span>
		</a>
		<a href="/notifications?filter=unread" class="btn btn-sm rounded-pill px-3 <%= activeFilter === 'unread' ? 'btn-forest' : 'btn-forest-outline' %>">
			Unread Only
			<% if (unreadCount > 0) { %>
				<span class="badge rounded-pill bg-danger text-white ms-1 font-tabular"><%= unreadCount %></span>
			<% } %>
		</a>
	</div>

	<!-- Notifications Feed -->
	<% if (!notifications || notifications.length === 0) { %>
		<div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 my-4 bg-white">
			<div class="card-body">
				<div class="mb-3 text-muted" style="font-size: 3rem; opacity: 0.35;">
					<i class="fa-regular fa-bell-slash"></i>
				</div>
				<h5 class="editorial-title fw-bold text-dark mb-1">You're all caught up!</h5>
				<p class="text-muted small mx-auto mb-3" style="max-width: 440px;">
					<%= activeFilter === 'unread' ? 'No unread notifications right now. Check back later or view your complete notification history.' : 'When you receive reservation updates, traveler messages, or booking disbursements, they will appear here.' %>
				</p>
				<% if (activeFilter === 'unread') { %>
					<a href="/notifications?filter=all" class="btn btn-forest-outline btn-sm rounded-pill px-4">
						View All Notifications
					</a>
				<% } else { %>
					<a href="/listings" class="btn btn-forest btn-sm rounded-pill px-4">
						Explore Sanctuaries
					</a>
				<% } %>
			</div>
		</div>
	<% } else { %>
		<div class="d-flex flex-column gap-3">
			<% for (const item of notifications) { %>
				<div class="card border-0 shadow-sm rounded-4 p-3 transition-hover position-relative <%= !item.isRead ? 'border-start border-4' : 'bg-white' %>" style="<%= !item.isRead ? 'border-color: var(--forest-800) !important; background-color: var(--paper-100);' : '' %>">
					<div class="d-flex align-items-start gap-3">
						<!-- Notification Icon by Event Type -->
						<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background-color: var(--paper-50); border: 1px solid var(--paper-200);">
							<% if (item.type === 'booking_confirmed') { %>
								<i class="fa-solid fa-calendar-check text-success fs-5"></i>
							<% } else if (item.type === 'booking_cancelled') { %>
								<i class="fa-solid fa-calendar-xmark text-danger fs-5"></i>
							<% } else if (item.type === 'payment_succeeded') { %>
								<i class="fa-solid fa-receipt text-forest fs-5"></i>
							<% } else if (item.type === 'payment_refunded') { %>
								<i class="fa-solid fa-money-bill-transfer text-warning fs-5"></i>
							<% } else if (item.type === 'new_message') { %>
								<i class="fa-solid fa-comment-dots text-forest fs-5"></i>
							<% } else if (item.type === 'new_review') { %>
								<i class="fa-solid fa-star fs-5" style="color: var(--gold);"></i>
							<% } else if (item.type === 'host_reply') { %>
								<i class="fa-solid fa-reply text-secondary fs-5"></i>
							<% } else { %>
								<i class="fa-solid fa-bell text-forest fs-5"></i>
							<% } %>
						</div>

						<!-- Content Body -->
						<div class="flex-grow-1">
							<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
								<h6 class="fw-bold mb-0 text-dark">
									<%= item.title %>
									<% if (!item.isRead) { %>
										<span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle ms-2" style="font-size: 0.68rem;">New</span>
									<% } %>
								</h6>
								<span class="text-muted small font-tabular" title="<%= new Date(item.createdAt).toISOString() %>" style="font-size: 0.75rem;">
									<i class="fa-regular fa-clock me-1"></i><%= new Date(item.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
								</span>
							</div>

							<p class="text-secondary small mb-2"><%= item.message %></p>

							<!-- Actions Bar -->
							<div class="d-flex align-items-center gap-2 mt-2">
								<% if (item.link) { %>
									<form action="/notifications/<%= item._id %>/read" method="POST" class="d-inline">
										<button type="submit" class="btn btn-sm btn-forest rounded-pill px-3 py-1" style="font-size: 0.8rem;">
											View Details <i class="fa-solid fa-arrow-right ms-1"></i>
										</button>
									</form>
								<% } %>

								<% if (!item.isRead) { %>
									<form action="/notifications/<%= item._id %>/read" method="POST" class="d-inline">
										<input type="hidden" name="action" value="markOnly" />
										<button type="submit" class="btn btn-sm btn-forest-outline rounded-pill px-3 py-1" style="font-size: 0.8rem;" title="Mark as read">
											<i class="fa-solid fa-check me-1"></i> Mark as Read
										</button>
									</form>
								<% } %>

								<form action="/notifications/<%= item._id %>/delete" method="POST" class="d-inline ms-auto">
									<button type="submit" class="btn btn-sm text-muted rounded-pill px-2 py-1 border-0" title="Delete notification" onclick="return confirm('Delete this notification?');">
										<i class="fa-regular fa-trash-can"></i>
									</button>
								</form>
							</div>
						</div>
					</div>
				</div>
			<% } %>
		</div>

		<!-- Pagination Navigation -->
		<% if (totalPages > 1) { %>
			<nav class="d-flex justify-content-center mt-4 pt-2" aria-label="Notifications pagination">
				<ul class="pagination pagination-sm gap-1">
					<li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
						<a class="page-link rounded-circle px-3" href="/notifications?filter=<%= activeFilter %>&page=<%= page - 1 %>">
							<i class="fa-solid fa-chevron-left"></i>
						</a>
					</li>
					<% for (let p = 1; p <= totalPages; p++) { %>
						<li class="page-item <%= p === page ? 'active' : '' %>">
							<a class="page-link rounded-circle px-3 <%= p === page ? 'btn-forest border-0 text-white' : '' %>" href="/notifications?filter=<%= activeFilter %>&page=<%= p %>">
								<%= p %>
							</a>
						</li>
					<% } %>
					<li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
						<a class="page-link rounded-circle px-3" href="/notifications?filter=<%= activeFilter %>&page=<%= page + 1 %>">
							<i class="fa-solid fa-chevron-right"></i>
						</a>
					</li>
				</ul>
			</nav>
		<% } %>
	<% } %>
</div>
