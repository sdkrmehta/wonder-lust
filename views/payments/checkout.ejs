<% layout("layouts/boilerplate") %>
<%
	const b = (typeof billingDefaults !== "undefined" && billingDefaults) ? billingDefaults : {};
	const countryList = (typeof countries !== "undefined" && Array.isArray(countries) && countries.length > 0)
		? countries
		: ["India", "Australia", "Canada", "France", "Germany", "Japan", "Singapore", "United Arab Emirates", "United Kingdom", "United States"];
	const selectedCountry = b.country || "India";
	const isIndia = selectedCountry.toLowerCase() === "india";
	const isGatewayReady = (typeof gatewayConfigured === "undefined") ? true : Boolean(gatewayConfigured);
%>

<div class="container my-4 my-md-5">
	<!-- Page Heading & Breadcrumb -->
	<div class="mb-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb small">
				<li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted">Explore</a></li>
				<li class="breadcrumb-item"><a href="/listings/<%= listing._id %>" class="text-decoration-none text-muted"><%= listing.title %></a></li>
				<li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">Checkout &amp; Billing</li>
			</ol>
		</nav>
		<h1 class="editorial-title text-dark mb-1" style="font-size: 2.2rem;">
			<i class="fa-solid fa-shield-halved me-2" style="color: var(--forest-800);"></i>Confirm and Pay
		</h1>
		<p class="text-muted small">Review your billing details and proceed to Razorpay's hosted secure payment page.</p>
	</div>

	<div class="row g-4 g-lg-5">
		<!-- Left Column: Editable Billing Details & Hosted Payment Redirect -->
		<div class="col-12 col-lg-7 order-2 order-lg-1">
			<form
				action="/payments/process/<%= booking._id %>"
				method="POST"
				id="checkoutPaymentForm"
				data-booking-id="<%= booking._id %>"
				novalidate
				class="needs-validation"
			>
				<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />

				<!-- Billing Details Card -->
				<div class="checkout-section-card">
					<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
						<div>
							<h5 class="fw-bold mb-1" style="color: var(--ink-900);">1. Billing Address &amp; Invoice Details</h5>
							<p class="text-muted small mb-0">Prefilled from your saved profile. You can edit any details for this reservation.</p>
						</div>
						<span class="stamp stamp-info" style="font-size: 0.7rem;">
							<i class="fa-solid fa-file-invoice me-1"></i> Tax Invoice Ready
						</span>
					</div>

					<div class="row g-3">
						<div class="col-12 col-md-6">
							<label for="billingFullName" class="form-label small fw-semibold text-dark">
								Full Name <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingFullName"
								name="billingDetails[fullName]"
								value="<%= b.fullName || '' %>"
								placeholder="Full name for invoice"
								minlength="2"
								maxlength="120"
								required
							/>
							<div class="invalid-feedback">Please enter the billing full name.</div>
						</div>

						<div class="col-12 col-md-6">
							<label for="billingEmail" class="form-label small fw-semibold text-dark">
								Billing Email Address <span class="text-danger">*</span>
							</label>
							<input
								type="email"
								class="form-control"
								id="billingEmail"
								name="billingDetails[email]"
								value="<%= b.email || '' %>"
								placeholder="name@example.com"
								required
							/>
							<div class="form-text small text-muted">For this tax invoice only; does not alter your login email.</div>
							<div class="invalid-feedback">Please enter a valid billing email address.</div>
						</div>

						<div class="col-12">
							<label for="billingAddressLine1" class="form-label small fw-semibold text-dark">
								Address Line 1 <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingAddressLine1"
								name="billingDetails[addressLine1]"
								placeholder="House / Flat No., Building, Street"
								value="<%= b.addressLine1 || '' %>"
								minlength="3"
								maxlength="200"
								required
							/>
							<div class="invalid-feedback">Please enter Address Line 1.</div>
						</div>

						<div class="col-12 col-md-6">
							<label for="billingAddressLine2" class="form-label small fw-semibold text-dark">
								Address Line 2 <span class="badge bg-light text-muted border fw-normal ms-1">Optional</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingAddressLine2"
								name="billingDetails[addressLine2]"
								placeholder="Apartment, Suite, Locality"
								value="<%= b.addressLine2 || '' %>"
								maxlength="200"
							/>
						</div>

						<div class="col-12 col-md-6">
							<label for="billingLandmark" class="form-label small fw-semibold text-dark">
								Landmark <span class="badge bg-light text-muted border fw-normal ms-1">Optional</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingLandmark"
								name="billingDetails[landmark]"
								placeholder="Nearby landmark"
								value="<%= b.landmark || '' %>"
								maxlength="150"
							/>
						</div>

						<div class="col-12 col-sm-6">
							<label for="billingCity" class="form-label small fw-semibold text-dark">
								City <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingCity"
								name="billingDetails[city]"
								value="<%= b.city || '' %>"
								placeholder="e.g. Mumbai"
								minlength="2"
								maxlength="100"
								required
							/>
							<div class="invalid-feedback">Please enter your city.</div>
						</div>

						<div class="col-12 col-sm-6">
							<label for="billingState" class="form-label small fw-semibold text-dark">
								State / Province <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								class="form-control"
								id="billingState"
								name="billingDetails[state]"
								value="<%= b.state || '' %>"
								placeholder="e.g. Maharashtra"
								minlength="2"
								maxlength="100"
								required
							/>
							<div class="invalid-feedback">Please enter your state or province.</div>
						</div>

						<div class="col-12 col-sm-6">
							<label for="billingCountry" class="form-label small fw-semibold text-dark">
								Country <span class="text-danger">*</span>
							</label>
							<select
								class="form-select"
								id="billingCountry"
								name="billingDetails[country]"
								data-checkout-postal-target="billingPostalCode"
								required
							>
								<% for (const c of countryList) { %>
									<option value="<%= c %>" <%= selectedCountry === c ? 'selected' : '' %>><%= c %></option>
								<% } %>
								<% if (!countryList.includes(selectedCountry)) { %>
									<option value="<%= selectedCountry %>" selected><%= selectedCountry %></option>
								<% } %>
							</select>
						</div>

						<div class="col-12 col-sm-6">
							<label for="billingPostalCode" class="form-label small fw-semibold text-dark">
								<span id="billingPostalCodeLabel"><%= isIndia ? 'PIN Code' : 'Postal Code' %></span> <span class="text-danger">*</span>
							</label>
							<input
								type="text"
								class="form-control tabular-nums"
								id="billingPostalCode"
								name="billingDetails[postalCode]"
								value="<%= b.postalCode || '' %>"
								placeholder="<%= isIndia ? '6-digit PIN code (e.g. 400001)' : 'Enter postal / ZIP code' %>"
								maxlength="20"
								required
							/>
							<div class="invalid-feedback" id="billingPostalCodeFeedback">Please enter a valid PIN / postal code.</div>
						</div>

						<div class="col-12 pt-2 border-top mt-3">
							<div class="form-check">
								<input
									class="form-check-input"
									type="checkbox"
									name="saveAsDefaultAddress"
									value="true"
									id="saveAsDefaultAddress"
								/>
								<label class="form-check-label small fw-medium text-dark" for="saveAsDefaultAddress">
									Save this address as my default billing address for future bookings.
								</label>
							</div>
						</div>
					</div>
				</div>

				<!-- Hosted Payment Link Overview Card -->
				<div class="checkout-section-card">
					<div class="d-flex align-items-center justify-content-between mb-3">
						<h5 class="fw-bold mb-0" style="color: var(--ink-900);">2. Hosted Secure Payment</h5>
						<span class="stamp stamp-info" style="font-size: 0.7rem;">
							<%= (typeof paymentProvider !== 'undefined' && paymentProvider === 'razorpay') ? 'Razorpay Payment Link' : 'Sandbox Gateway' %>
						</span>
					</div>

					<div class="p-3 rounded-4 d-flex align-items-start gap-3" style="background-color: var(--forest-50); border: 1px solid var(--forest-100);">
						<i class="fa-solid fa-up-right-from-square fa-lg mt-1" style="color: var(--forest-800);"></i>
						<div class="small">
							<div class="fw-semibold text-dark mb-1">You will be redirected to Razorpay's official hosted payment page</div>
							<p class="text-muted mb-0">
								Pay securely using UPI, Credit/Debit Cards, NetBanking, or Wallets directly on Razorpay. Wonder-Lust never collects or stores your card numbers, CVV, or banking PINs. Razorpay may ask you to confirm contact details on its hosted checkout page.
							</p>
						</div>
					</div>
				</div>

				<!-- Async / Config Status Banner -->
				<div
					id="paymentStatusAlert"
					class="alert <%= isGatewayReady ? 'alert-info d-none' : 'alert-warning' %> mb-3 small"
					role="status"
				><% if (!isGatewayReady) { %><% if (typeof paymentProvider !== 'undefined' && paymentProvider === 'razorpay') { %>Razorpay checkout is currently disabled because <code>RAZORPAY_KEY_ID</code> or <code>RAZORPAY_KEY_SECRET</code> is missing in the server environment.<% } else { %>Payment checkout is currently disabled because webhook verification credentials are not configured in the server environment.<% } %><% } %></div>

				<!-- CTA Continue Button -->
				<button
					type="submit"
					class="btn btn-forest w-100 rounded-pill py-3 fw-bold fs-5 shadow-sm"
					id="submitPaymentBtn"
					<%= isGatewayReady ? '' : 'disabled' %>
				>
					<% if (isGatewayReady) { %>
						<i class="fa-solid fa-lock me-2"></i>Continue to secure payment (&#x20B9;<%= booking.totalPrice.toLocaleString("en-IN") %>)
					<% } else { %>
						<i class="fa-solid fa-triangle-exclamation me-2"></i>Payment Gateway Not Configured
					<% } %>
				</button>
				<p class="text-center text-muted small mt-2">
					By continuing, you agree to the Wonder-Lust Guest Refund Policy and <a href="/terms" class="text-forest text-decoration-none fw-semibold">Terms of Service</a>.
				</p>
			</form>
		</div>

		<!-- Right Column: Reservation Summary Card -->
		<div class="col-12 col-lg-5 order-1 order-lg-2">
			<div class="summary-sticky-card">
				<h5 class="fw-bold mb-3" style="color: var(--ink-900);">Reservation Summary</h5>

				<!-- Property Mini-Card -->
				<div class="d-flex gap-3 pb-3 border-bottom mb-3" style="border-color: var(--border-color) !important;">
					<img
						src="<%= listing.image && listing.image.url ? listing.image.url : '/images/listing-placeholder.jpg' %>"
						alt="<%= listing.title %>"
						class="rounded-3 shadow-sm"
						style="width: 90px; height: 90px; object-fit: cover;"
						data-fallback-src="/images/listing-placeholder.jpg"
					/>
					<div>
						<h6 class="fw-bold mb-1" style="color: var(--ink-900);"><%= listing.title %></h6>
						<p class="text-muted small mb-1">
							<i class="fa-solid fa-location-dot me-1 text-danger"></i>
							<%= listing.location %>, <%= listing.country %>
						</p>
						<span class="badge bg-light text-dark border">
							<i class="fa-solid fa-star text-warning me-1"></i>
							<%= (listing.avgRating && listing.avgRating > 0) ? Number(listing.avgRating).toFixed(1) : "New" %>
						</span>
					</div>
				</div>

				<!-- Dates & Guests Row -->
				<div class="row g-2 pb-3 border-bottom mb-3 small" style="border-color: var(--border-color) !important;">
					<div class="col-6">
						<span class="text-muted d-block">Check-in</span>
						<span class="fw-semibold text-dark">
							<%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %>
						</span>
					</div>
					<div class="col-6">
						<span class="text-muted d-block">Check-out</span>
						<span class="fw-semibold text-dark">
							<%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %>
						</span>
					</div>
					<div class="col-6 mt-2">
						<span class="text-muted d-block">Guests</span>
						<span class="fw-semibold text-dark"><%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %></span>
					</div>
					<div class="col-6 mt-2">
						<span class="text-muted d-block">Duration</span>
						<span class="fw-semibold text-dark"><%= booking.totalNights %> night<%= booking.totalNights > 1 ? 's' : '' %></span>
					</div>
				</div>

				<!-- Itemized Financial Breakdown -->
				<h6 class="fw-bold mb-2" style="color: var(--ink-900);">Price Breakdown</h6>
				<table class="table table-borderless table-sm mb-3">
					<tbody>
						<tr>
							<td class="text-muted">&#x20B9;<%= booking.nightlyPrice.toLocaleString("en-IN") %> &times; <%= booking.totalNights %> night<%= booking.totalNights > 1 ? 's' : '' %></td>
							<td class="text-end fw-medium tabular-nums">&#x20B9;<%= (booking.nightlyPrice * booking.totalNights).toLocaleString("en-IN") %></td>
						</tr>
						<tr>
							<td class="text-muted">Cleaning Fee</td>
							<td class="text-end fw-medium tabular-nums">&#x20B9;<%= (booking.cleaningFee || 500).toLocaleString("en-IN") %></td>
						</tr>
						<tr>
							<td class="text-muted">GST &amp; Applicable Taxes (18%)</td>
							<td class="text-end fw-medium tabular-nums">&#x20B9;<%= (booking.taxAmount || 0).toLocaleString("en-IN") %></td>
						</tr>
						<tr class="border-top" style="border-color: var(--border-color) !important;">
							<td class="fw-bold fs-6 pt-2">Total Payable (INR)</td>
							<td class="text-end fw-bold fs-5 pt-2 tabular-nums" style="color: var(--forest-900);">&#x20B9;<%= booking.totalPrice.toLocaleString("en-IN") %></td>
						</tr>
					</tbody>
				</table>

				<!-- Cancellation Guarantee -->
				<div class="p-3 rounded-3 small text-muted" style="background-color: var(--paper-100); border: 1px solid var(--border-color);">
					<i class="fa-solid fa-circle-check text-success me-1"></i>
					<strong class="text-dark">Verified pricing &amp; free cancellation:</strong> Final payable amount is verified server-side. Cancel anytime before check-in for a full refund.
				</div>
			</div>
		</div>
	</div>
</div>

<script nonce="<%= cspNonce || '' %>" src="/js/checkout.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
