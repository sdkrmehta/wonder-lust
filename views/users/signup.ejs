<% layout("/layouts/boilerplate") %>

<div class="container-narrow py-5 my-md-4">
	<!-- Editorial Header -->
	<div class="text-center mb-4">
		<span class="badge rounded-pill px-3 py-2 mb-2 border text-uppercase tracking-wider fw-semibold" style="background-color: var(--forest-100); color: var(--forest-900); font-size: 0.75rem; letter-spacing: 0.05em;">
			<i class="fa-regular fa-compass me-1"></i> Wander-Lust Membership
		</span>
		<h1 class="editorial-title display-6 fw-bold mb-2">Create your account</h1>
		<p class="text-muted small mx-auto" style="max-width: 480px;">
			Join a curated community of discerning travelers and passionate hosts. Discover extraordinary sanctuaries across the globe.
		</p>
	</div>

	<!-- Registration Card -->
	<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
		<form
			action="/signup"
			method="POST"
			class="needs-validation"
			novalidate
		>
			<!-- Username Field -->
			<div class="mb-3">
				<label for="username" class="form-label small fw-semibold text-dark mb-1">
					Username <span class="text-danger">*</span>
				</label>
				<div class="input-group">
					<span class="input-group-text bg-light text-muted border-end-0">
						<i class="fa-regular fa-user"></i>
					</span>
					<input
						name="username"
						id="username"
						type="text"
						class="form-control border-start-0 ps-0"
						placeholder="e.g. wanderer_maya"
						autocomplete="username"
						required
					/>
					<div class="invalid-feedback">
						Please choose a username.
					</div>
				</div>
				<div class="form-text small text-muted">Your public identity for reviews, bookings, and host messaging.</div>
			</div>

			<!-- Email Field -->
			<div class="mb-3">
				<label for="email" class="form-label small fw-semibold text-dark mb-1">
					Email Address <span class="text-danger">*</span>
				</label>
				<div class="input-group">
					<span class="input-group-text bg-light text-muted border-end-0">
						<i class="fa-regular fa-envelope"></i>
					</span>
					<input
						name="email"
						id="email"
						type="email"
						class="form-control border-start-0 ps-0"
						placeholder="name@example.com"
						autocomplete="email"
						required
					/>
					<div class="invalid-feedback">
						Please enter a valid email address.
					</div>
				</div>
				<div class="form-text small text-muted">We will send booking confirmations, tax invoices, and itinerary details here.</div>
			</div>

			<!-- Password Field -->
			<div class="mb-4">
				<label for="password" class="form-label small fw-semibold text-dark mb-1">
					Password <span class="text-danger">*</span>
				</label>
				<div class="input-group">
					<span class="input-group-text bg-light text-muted border-end-0">
						<i class="fa-solid fa-lock"></i>
					</span>
					<input
						name="password"
						id="password"
						type="password"
						class="form-control border-start-0 ps-0"
						placeholder="Minimum 6 characters"
						autocomplete="new-password"
						required
					/>
					<button
						class="btn btn-outline-secondary border-start-0 px-3"
						type="button"
						id="togglePasswordBtn"
						onclick="togglePasswordVisibility('password', this)"
						title="Toggle password visibility"
						aria-label="Toggle password visibility"
					>
						<i class="fa-regular fa-eye"></i>
					</button>
					<div class="invalid-feedback">
						Please choose a password.
					</div>
				</div>
				<div class="form-text small text-muted">Use at least 6 characters including numbers and letters for security.</div>
			</div>

			<!-- Terms Agreement -->
			<div class="form-check mb-4 small text-muted">
				<input class="form-check-input" type="checkbox" value="" id="termsCheck" required checked>
				<label class="form-check-label" for="termsCheck">
					I agree to Wander-Lust's <a href="/terms" class="text-forest text-decoration-none fw-semibold">Terms of Service</a> and <a href="/privacy" class="text-forest text-decoration-none fw-semibold">Privacy Policy</a>.
				</label>
				<div class="invalid-feedback">
					You must agree before submitting.
				</div>
			</div>

			<!-- Submit Button -->
			<button type="submit" class="btn btn-forest add-btn w-100 py-2 fw-semibold fs-6 shadow-sm">
				<i class="fa-solid fa-user-plus me-2"></i>Create Account
			</button>
		</form>
	</div>

	<!-- Login Alternative -->
	<div class="text-center">
		<p class="text-muted small mb-3">
			Already have an account? <a href="/login" class="text-forest text-decoration-none fw-bold">Log in</a>
		</p>

		<!-- Trust Badges Strip -->
		<div class="d-flex flex-wrap justify-content-center gap-4 pt-3 border-top text-muted small" style="font-size: 0.8rem;">
			<span><i class="fa-solid fa-shield-halved text-success me-1"></i> Verified Sanctuaries</span>
			<span><i class="fa-solid fa-lock text-forest me-1"></i> Bank-Grade Encryption</span>
			<span><i class="fa-solid fa-headset text-terracotta me-1"></i> 24/7 Dedicated Support</span>
		</div>
	</div>
</div>

<script>
	function togglePasswordVisibility(fieldId, btn) {
		const inp = document.getElementById(fieldId);
		if (!inp) return;
		if (inp.type === 'password') {
			inp.type = 'text';
			btn.innerHTML = '<i class="fa-regular fa-eye-slash"></i>';
		} else {
			inp.type = 'password';
			btn.innerHTML = '<i class="fa-regular fa-eye"></i>';
		}
	}
</script>
