<% layout("/layouts/boilerplate") %>
<%
	const fd = (typeof formData !== "undefined" && formData) ? formData : {};
	const countryList = (typeof countries !== "undefined" && Array.isArray(countries) && countries.length > 0)
		? countries
		: ["India", "Australia", "Canada", "France", "Germany", "Japan", "Singapore", "United Arab Emirates", "United Kingdom", "United States"];
	const selectedCountry = fd.country || "India";
	const isIndia = selectedCountry.toLowerCase() === "india";
%>

<div class="container-standard py-5 my-md-4" style="max-width: 780px;">
	<!-- Editorial Header -->
	<div class="text-center mb-4">
		<span class="badge rounded-pill px-3 py-2 mb-2 border text-uppercase tracking-wider fw-semibold" style="background-color: var(--forest-100); color: var(--forest-900); font-size: 0.75rem; letter-spacing: 0.05em;">
			<i class="fa-regular fa-compass me-1"></i> Wonder-Lust Membership
		</span>
		<h1 class="editorial-title display-6 fw-bold mb-2">Create your account</h1>
		<p class="text-muted small mx-auto" style="max-width: 520px;">
			Join a curated community of discerning travelers and passionate hosts. Complete your profile and address once for seamless verified bookings and tax invoices.
		</p>
	</div>

	<!-- Registration Card -->
	<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
		<form
			action="/signup"
			method="POST"
			id="signupForm"
			class="needs-validation"
			novalidate
		>
			<input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />

			<!-- Section A: Personal Information -->
			<div class="mb-4 pb-2 border-bottom">
				<div class="d-flex align-items-center justify-content-between mb-3">
					<h2 class="h5 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
						<span class="section-indicator me-1">1</span>
						Personal Information
					</h2>
					<span class="text-muted small"><span class="text-danger">*</span> Required fields</span>
				</div>

				<div class="row g-3">
					<!-- Full Name -->
					<div class="col-12 col-md-6">
						<label for="fullName" class="form-label small fw-semibold text-dark mb-1">
							Full Name <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<span class="input-group-text bg-light text-muted border-end-0">
								<i class="fa-regular fa-user"></i>
							</span>
							<input
								name="fullName"
								id="fullName"
								type="text"
								class="form-control border-start-0 ps-0"
								placeholder="e.g. Maya Sharma"
								autocomplete="name"
								minlength="2"
								maxlength="100"
								value="<%= fd.fullName || '' %>"
								required
							/>
							<div class="invalid-feedback">
								Please enter your full name (at least 2 characters).
							</div>
						</div>
					</div>

					<!-- Email Address -->
					<div class="col-12 col-md-6">
						<label for="email" class="form-label small fw-semibold text-dark mb-1">
							Email Address <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<span class="input-group-text bg-light text-muted border-end-0">
								<i class="fa-regular fa-envelope"></i>
							</span>
							<input
								name="email"
								id="email"
								type="email"
								class="form-control border-start-0 ps-0"
								placeholder="name@example.com"
								autocomplete="email"
								value="<%= fd.email || '' %>"
								required
							/>
							<div class="invalid-feedback">
								Please enter a valid email address for OTP verification.
							</div>
						</div>
						<div class="form-text small text-muted">We will send a 6-digit verification code to this email.</div>
					</div>

					<!-- Password -->
					<div class="col-12 col-md-6">
						<label for="password" class="form-label small fw-semibold text-dark mb-1">
							Password <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<span class="input-group-text bg-light text-muted border-end-0">
								<i class="fa-solid fa-lock"></i>
							</span>
							<input
								name="password"
								id="password"
								type="password"
								class="form-control border-start-0 ps-0"
								placeholder="Min 8 chars, upper, lower & number"
								autocomplete="new-password"
								minlength="8"
								maxlength="128"
								required
							/>
							<button
								class="btn btn-outline-secondary border-start-0 px-3"
								type="button"
								id="togglePasswordBtn"
								data-toggle-password="password"
								title="Toggle password visibility"
								aria-label="Toggle password visibility"
								aria-controls="password"
							>
								<i class="fa-regular fa-eye"></i>
							</button>
							<div class="invalid-feedback">
								Use at least 8 characters with uppercase, lowercase, and a number.
							</div>
						</div>
					</div>

					<!-- Confirm Password -->
					<div class="col-12 col-md-6">
						<label for="confirmPassword" class="form-label small fw-semibold text-dark mb-1">
							Confirm Password <span class="text-danger">*</span>
						</label>
						<div class="input-group">
							<span class="input-group-text bg-light text-muted border-end-0">
								<i class="fa-solid fa-shield-check"></i>
							</span>
							<input
								name="confirmPassword"
								id="confirmPassword"
								type="password"
								class="form-control border-start-0 ps-0"
								placeholder="Re-enter your password"
								autocomplete="new-password"
								minlength="8"
								maxlength="128"
								required
							/>
							<button
								class="btn btn-outline-secondary border-start-0 px-3"
								type="button"
								id="toggleConfirmPasswordBtn"
								data-toggle-password="confirmPassword"
								title="Toggle confirm password visibility"
								aria-label="Toggle confirm password visibility"
								aria-controls="confirmPassword"
							>
								<i class="fa-regular fa-eye"></i>
							</button>
							<div class="invalid-feedback" id="confirmPasswordFeedback">
								Passwords must match.
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Section B: Address Information -->
			<div class="mb-4">
				<h2 class="h5 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
					<span class="section-indicator me-1">2</span>
					Address Information
				</h2>

				<div class="row g-3">
					<!-- Address Line 1 -->
					<div class="col-12">
						<label for="addressLine1" class="form-label small fw-semibold text-dark mb-1">
							Address Line 1 <span class="text-danger">*</span>
						</label>
						<input
							name="addressLine1"
							id="addressLine1"
							type="text"
							class="form-control"
							placeholder="House / Flat No., Building Name, Street"
							autocomplete="address-line1"
							minlength="3"
							maxlength="200"
							value="<%= fd.addressLine1 || '' %>"
							required
						/>
						<div class="invalid-feedback">
							Please enter your street address (at least 3 characters).
						</div>
					</div>

					<!-- Address Line 2 (Optional) -->
					<div class="col-12 col-md-6">
						<label for="addressLine2" class="form-label small fw-semibold text-dark mb-1">
							Address Line 2 <span class="badge bg-light text-muted border fw-normal ms-1">Optional</span>
						</label>
						<input
							name="addressLine2"
							id="addressLine2"
							type="text"
							class="form-control"
							placeholder="Apartment, Suite, Locality, Sector"
							autocomplete="address-line2"
							maxlength="200"
							value="<%= fd.addressLine2 || '' %>"
						/>
					</div>

					<!-- Landmark (Optional) -->
					<div class="col-12 col-md-6">
						<label for="landmark" class="form-label small fw-semibold text-dark mb-1">
							Landmark <span class="badge bg-light text-muted border fw-normal ms-1">Optional</span>
						</label>
						<input
							name="landmark"
							id="landmark"
							type="text"
							class="form-control"
							placeholder="e.g. Near City Park or Metro Station"
							maxlength="150"
							value="<%= fd.landmark || '' %>"
						/>
					</div>

					<!-- City -->
					<div class="col-12 col-sm-6">
						<label for="city" class="form-label small fw-semibold text-dark mb-1">
							City <span class="text-danger">*</span>
						</label>
						<input
							name="city"
							id="city"
							type="text"
							class="form-control"
							placeholder="e.g. Mumbai"
							autocomplete="address-level2"
							minlength="2"
							maxlength="100"
							value="<%= fd.city || '' %>"
							required
						/>
						<div class="invalid-feedback">
							Please enter your city.
						</div>
					</div>

					<!-- State -->
					<div class="col-12 col-sm-6">
						<label for="state" class="form-label small fw-semibold text-dark mb-1">
							State / Province <span class="text-danger">*</span>
						</label>
						<input
							name="state"
							id="state"
							type="text"
							class="form-control"
							placeholder="e.g. Maharashtra"
							autocomplete="address-level1"
							minlength="2"
							maxlength="100"
							value="<%= fd.state || '' %>"
							required
						/>
						<div class="invalid-feedback">
							Please enter your state or province.
						</div>
					</div>

					<!-- Country -->
					<div class="col-12 col-sm-6">
						<label for="country" class="form-label small fw-semibold text-dark mb-1">
							Country <span class="text-danger">*</span>
						</label>
						<select
							name="country"
							id="country"
							class="form-select"
							autocomplete="country-name"
							data-postal-target="postalCode"
							required
						>
							<% for (const c of countryList) { %>
								<option value="<%= c %>" <%= selectedCountry === c ? 'selected' : '' %>><%= c %></option>
							<% } %>
						</select>
						<div class="invalid-feedback">
							Please select your country.
						</div>
					</div>

					<!-- PIN Code / Postal Code -->
					<div class="col-12 col-sm-6">
						<label for="postalCode" class="form-label small fw-semibold text-dark mb-1">
							<span id="postalCodeLabel"><%= isIndia ? 'PIN Code' : 'Postal Code' %></span> <span class="text-danger">*</span>
						</label>
						<input
							name="postalCode"
							id="postalCode"
							type="text"
							class="form-control tabular-nums"
							placeholder="<%= isIndia ? '6-digit PIN code (e.g. 400001)' : 'Enter postal / ZIP code' %>"
							autocomplete="postal-code"
							maxlength="20"
							value="<%= fd.postalCode || '' %>"
							required
						/>
						<div class="invalid-feedback" id="postalCodeFeedback">
							Please enter a valid PIN / postal code for the selected country.
						</div>
					</div>
				</div>
			</div>

			<!-- Terms Agreement -->
			<div class="form-check mb-4 small text-muted">
				<input
					class="form-check-input"
					type="checkbox"
					name="termsAccepted"
					value="true"
					id="termsCheck"
					<%= fd.termsAccepted ? 'checked' : '' %>
					required
				/>
				<label class="form-check-label" for="termsCheck">
					I agree to Wonder-Lust's <a href="/terms" class="text-forest text-decoration-none fw-semibold">Terms of Service</a> and <a href="/privacy" class="text-forest text-decoration-none fw-semibold">Privacy Policy</a>. <span class="text-danger">*</span>
				</label>
				<div class="invalid-feedback">
					You must agree to the Terms of Service and Privacy Policy before registering.
				</div>
			</div>

			<!-- Submit Button -->
			<button type="submit" class="btn btn-forest add-btn w-100 py-2 fw-semibold fs-6 shadow-sm">
				<i class="fa-solid fa-envelope-circle-check me-2"></i>Continue &amp; Verify Email
			</button>
		</form>
	</div>

	<!-- Login Alternative -->
	<div class="text-center">
		<p class="text-muted small mb-3">
			Already have an account? <a href="/login" class="text-forest text-decoration-none fw-bold">Log in</a>
		</p>

		<!-- Trust Badges Strip -->
		<div class="d-flex flex-wrap justify-content-center gap-4 pt-3 border-top text-muted small" style="font-size: 0.8rem;">
			<span><i class="fa-solid fa-envelope-open-text text-success me-1"></i> Email OTP Verified</span>
			<span><i class="fa-solid fa-lock text-forest me-1"></i> Bank-Grade Encryption</span>
			<span><i class="fa-solid fa-headset text-terracotta me-1"></i> 24/7 Dedicated Support</span>
		</div>
	</div>
</div>

<script nonce="<%= cspNonce || '' %>" src="/js/auth-profile.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
