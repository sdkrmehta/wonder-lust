			<!-- Right Column: Interactive Booking Widget -->
			<div class="col-12 col-lg-5">
				<div class="card booking-card-sticky p-4">
					<!-- Widget Header -->
					<div class="d-flex justify-content-between align-items-baseline mb-3">
						<div>
							<span class="fs-3 fw-bold tabular-nums" style="color: var(--forest-900);">&#x20B9;<%= (listing.price || 0).toLocaleString("en-IN") %></span>
							<span class="text-muted small"> / night</span>
						</div>
						<div class="small fw-semibold">
							<i class="fa-solid fa-star text-warning"></i>
							<%= (listing.avgRating && listing.avgRating > 0) ? Number(listing.avgRating).toFixed(1) : "New" %>
