										type="date"
										class="form-control form-control-sm border-0 bg-white shadow-none"
										id="checkOutInput"
										name="booking[checkOut]"
										required
									/>
								</div>
							</div>
							<div class="d-flex justify-content-between align-items-center px-1 pb-2 pt-1 border-top" style="border-color: var(--border-color) !important;">
								<a href="#availabilitySection" class="text-decoration-none small text-success fw-semibold" style="font-size: 0.78rem;">
									<i class="fa-solid fa-calendar-days me-1"></i>View Calendar
								</a>
								<span id="bookingStatusPill" class="badge bg-secondary-subtle text-secondary small border" style="font-size: 0.72rem;">
									Select on calendar
								</span>
							</div>
							<div class="border-top pt-2" style="border-color: var(--border-color) !important;">
								<label for="guestsInput" class="form-label small fw-bold text-muted mb-0" style="font-size: 0.72rem; letter-spacing: 0.04em;">GUESTS</label>
								<select class="form-select form-select-sm border-0 bg-white shadow-none" id="guestsInput" name="booking[guests]">
									<% const maxG = listing.guests || 2; %>
									<% for (let g = 1; g <= maxG; g++) { %>
										<option value="<%= g %>"><%= g %> guest<%= g > 1 ? 's' : '' %></option>
									<% } %>
								</select>
							</div>
						</div>

						<!-- Conflict Alert Banner -->
						<div id="bookingConflictAlert" class="alert alert-danger py-2 small d-none">
							<i class="fa-solid fa-calendar-xmark me-1"></i> These dates are already booked! Please select another date range.
						</div>

						<!-- Action Button -->
						<% if (!currUser) { %>
							<a href="/login" class="btn btn-forest w-100 rounded-pill py-2 fw-semibold">
								Log in to Reserve
							</a>
						<% } else if (listing.owner && currUser._id.equals(listing.owner._id)) { %>
							<button type="button" class="btn btn-secondary w-100 rounded-pill py-2 fw-semibold" disabled>
								You Host This Property
							</button>
						<% } else { %>
							<button type="submit" class="btn btn-forest w-100 rounded-pill py-2 fw-semibold" id="reserveSubmitBtn">
								Reserve Now
							</button>
						<% } %>
						<p class="text-center text-muted small mt-2 mb-3">You won't be charged yet</p>

						<!-- Dynamic Pricing Calculation Box -->
						<div id="priceCalculationContainer" class="d-none border-top pt-3" style="border-color: var(--border-color) !important;">
							<div class="d-flex justify-content-between mb-2 small">
								<span id="nightlyCalculationLabel">&#x20B9;<%= listing.price %> &times; 1 night</span>
								<span class="fw-semibold tabular-nums" id="baseCalculationAmount">&#x20B9;<%= listing.price %></span>
							</div>
							<div class="d-flex justify-content-between mb-2 small">
								<span>Cleaning fee</span>
								<span class="fw-semibold tabular-nums">&#x20B9;500</span>
							</div>
							<div class="d-flex justify-content-between mb-2 small">
								<span>GST &amp; Taxes (18%)</span>
								<span class="fw-semibold tabular-nums" id="taxCalculationAmount">&#x20B9;0</span>
							</div>
							<div class="d-flex justify-content-between border-top pt-2 mt-2 fw-bold text-dark fs-6" style="border-color: var(--border-color) !important;">
								<span>Total</span>
								<span id="totalCalculationAmount" class="fs-5 tabular-nums" style="color: var(--forest-900);">&#x20B9;0</span>
							</div>
						</div>

						<!-- Security & Protection Callout -->
						<div class="d-flex align-items-center gap-2 text-muted small mt-3 pt-2 border-top" style="border-color: var(--border-color) !important;">
							<i class="fa-solid fa-shield-halved text-success"></i>
							<span style="font-size: 0.76rem;">Wander-Lust Protection Guarantee &bull; 256-bit Secure</span>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

