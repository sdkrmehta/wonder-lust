<%
  const curPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : '';
  const navUser = (typeof currUser !== 'undefined' && currUser) ? currUser : ((typeof locals !== 'undefined' && locals.currUser) ? locals.currUser : null);
%>
<!-- Responsive Mobile Bottom Navigation Bar -->
<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
	<a href="/listings" class="bottom-nav-item <%= (curPath.startsWith('/listings') && curPath !== '/listings/new') || curPath === '/' || curPath === '/home' ? 'active' : '' %>">
		<i class="fa-regular fa-compass"></i>
		<span>Explore</span>
	</a>
	<a href="#wishlist" class="bottom-nav-item" data-action="openWishlistModal()">
		<i class="fa-regular fa-heart"></i>
		<span>Wishlist</span>
	</a>
	<a href="/listings/new" class="bottom-nav-item <%= curPath === '/listings/new' ? 'active' : '' %>">
		<i class="fa-solid fa-circle-plus text-forest" style="font-size: 1.35rem;"></i>
		<span>Host</span>
	</a>
	<% if (navUser) { %>
		<a href="/bookings" class="bottom-nav-item <%= curPath.startsWith('/bookings') ? 'active' : '' %>">
			<i class="fa-solid fa-suitcase-rolling"></i>
			<span>Trips</span>
		</a>
		<a href="/profile" class="bottom-nav-item <%= curPath.startsWith('/profile') ? 'active' : '' %>" title="My Profile">
			<i class="fa-regular fa-user"></i>
			<span class="text-truncate" style="max-width: 60px;"><%= navUser.username %></span>
		</a>
	<% } else { %>
		<a href="/login" class="bottom-nav-item <%= curPath === '/login' ? 'active' : '' %>">
			<i class="fa-regular fa-user"></i>
			<span>Log In</span>
		</a>
	<% } %>
</nav>
