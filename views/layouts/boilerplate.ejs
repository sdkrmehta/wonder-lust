<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Discover handpicked vacation rentals, boutique villas, cabins, and unique stays around the globe with Wonder-Lust." />
		<meta name="csrf-token" content="<%= csrfToken || '' %>" />
		<title>Wonder-Lust | Vacation Rentals &amp; Unique Accommodations</title>

		<!-- Preconnect to Google Fonts & Content CDN -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<!-- Typography: Fraunces (Editorial Display) & Inter (UI & Data) -->
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Bootstrap 5.3.3 Core -->
		<link
			href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
			rel="stylesheet"
			integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
			crossorigin="anonymous"
		/>

		<!-- FontAwesome Icons -->
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
			integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>

		<!-- Leaflet Interactive Maps -->
		<link
			rel="stylesheet"
			href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
			integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
			crossorigin=""
		/>

		<!-- Component & Rating Styles -->
		<link href="/css/rating.css" rel="stylesheet" />

		<!-- Wonder-Lust Design System Styles -->
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<!-- Accessible Skip to Main Content Link -->
		<a href="#mainContent" class="skip-link">Skip to main content</a>

		<!-- Top Global Navigation Bar -->
		<%- include("../includes/navbar.ejs") %>

		<!-- Main Application View Port -->
		<main id="mainContent" class="<%= (typeof isFluid !== 'undefined' && isFluid) ? 'p-0 m-0' : 'container my-4' %>">
			<%- include("../includes/flash.ejs") %>
			<%- body %>
		</main>

		<!-- Global Editorial Footer -->
		<%- include("../includes/footer.ejs") %>

		<!-- Mobile Bottom Navigation Drawer -->
		<%- include("../includes/bottom-nav.ejs") %>

		<!-- Vendor & Application Scripts -->
		<script
			nonce="<%= cspNonce || '' %>"
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
			crossorigin="anonymous"
		></script>
		<script
			nonce="<%= cspNonce || '' %>"
			src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
			integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
			crossorigin=""
		></script>
		<script nonce="<%= cspNonce || '' %>" src="/js/script.js"></script>
		<script nonce="<%= cspNonce || '' %>" src="/js/search.js"></script>
	</body>
</html>
