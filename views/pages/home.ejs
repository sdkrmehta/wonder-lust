<% layout("layouts/boilerplate") %>

<!-- ==========================================================================
     SECTION 2: HERO SECTION WITH BOOKING ENGINE
     ========================================================================== -->
<section class="hero-section position-relative d-flex align-items-center" id="hero">
	<div class="hero-bg-overlay"></div>
	<div class="container position-relative hero-content text-white py-5">
		<div class="row justify-content-center text-center mb-4">
			<div class="col-12 col-lg-10">
				<!-- Editorial Pill Badge -->
				<div class="d-inline-flex align-items-center gap-2 hero-pill-badge mb-3 px-3 py-1 rounded-pill">
					<i class="fa-solid fa-sparkles text-warning"></i>
					<span>Curated Escapes &bull; Handpicked Stays Across 35+ Countries</span>
				</div>
				<!-- Main Heading -->
				<h1 class="hero-title text-white mb-3">
					Discover the World.<br />Create Your Own Story.
				</h1>
				<!-- Supporting Text -->
				<p class="hero-subtitle col-md-10 col-lg-8 mx-auto mb-4">
					Explore breathtaking destinations, find amazing stays, and make every journey unforgettable.
				</p>
			</div>
		</div>

		<!-- Booking Search Bar Engine -->
		<div class="hero-search-wrapper mx-auto col-12 col-xl-11 expanded-search-container" id="heroSearchWrapper">
			<%- include("../includes/search-bar.ejs", {
				formId: "heroSearchForm",
				searchQuery: (typeof searchQuery !== 'undefined' ? searchQuery : ''),
				filters: (typeof filters !== 'undefined' ? filters : {})
			}) %>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 3: TRAVEL STATISTICS (HORIZONTAL STATS BAR)
     ========================================================================== -->
<section class="stats-section py-4" id="travel-stats">
	<div class="container">
		<div class="row g-3 g-md-4 text-center justify-content-center">
			<!-- Stat 1 -->
			<div class="col-6 col-md-3">
				<div class="stat-card p-3 rounded-4 h-100">
					<div class="stat-icon-circle mx-auto mb-2 text-primary">
						<i class="fa-solid fa-earth-americas fa-2x"></i>
					</div>
					<h3 class="stat-number fw-bold mb-1"><%= stats.totalDestinations %></h3>
					<p class="stat-label text-muted small mb-0">Total Destinations</p>
				</div>
			</div>
			<!-- Stat 2 -->
			<div class="col-6 col-md-3">
				<div class="stat-card p-3 rounded-4 h-100">
					<div class="stat-icon-circle mx-auto mb-2 text-warning">
						<i class="fa-solid fa-hotel fa-2x"></i>
					</div>
					<h3 class="stat-number fw-bold mb-1"><%= stats.availableHotels %></h3>
					<p class="stat-label text-muted small mb-0">Available Hotels</p>
				</div>
			</div>
			<!-- Stat 3 -->
			<div class="col-6 col-md-3">
				<div class="stat-card p-3 rounded-4 h-100">
					<div class="stat-icon-circle mx-auto mb-2 text-success">
						<i class="fa-regular fa-face-smile fa-2x"></i>
					</div>
					<h3 class="stat-number fw-bold mb-1"><%= stats.happyTravelers %></h3>
					<p class="stat-label text-muted small mb-0">Happy Travelers</p>
				</div>
			</div>
			<!-- Stat 4 -->
			<div class="col-6 col-md-3">
				<div class="stat-card p-3 rounded-4 h-100">
					<div class="stat-icon-circle mx-auto mb-2 text-danger">
						<i class="fa-solid fa-flag fa-2x"></i>
					</div>
					<h3 class="stat-number fw-bold mb-1"><%= stats.countriesCovered %></h3>
					<p class="stat-label text-muted small mb-0">Countries Covered</p>
				</div>
			</div>
		</div>
		<div class="text-center mt-2">
			<span class="text-muted" style="font-size: 0.72rem;">*Demonstration metrics presented for exploration</span>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 4: WHY CHOOSE WANDERLUST?
     ========================================================================== -->
<section class="py-5 bg-light-section" id="why-choose-us">
	<div class="container py-3">
		<div class="section-heading-wrapper text-center mb-5">
			<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">The Wanderlust Advantage</span>
			<h2 class="section-title fw-bold">Why Choose Wanderlust?</h2>
			<p class="section-subtitle text-muted col-md-8 col-lg-6 mx-auto">
				Everything you need for a comfortable and unforgettable journey.
			</p>
		</div>

		<div class="row g-4">
			<!-- Card 1: Comfortable Stays -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-navy-50 text-navy">
						<i class="fa-solid fa-bed fa-xl text-primary"></i>
					</div>
					<h5 class="fw-bold mb-2">Comfortable Stays</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Find comfortable accommodation for every type of journey. From boutique heritage homes to ultra-modern beachfront villas.
					</p>
				</div>
			</div>

			<!-- Card 2: Amazing Destinations -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-warning-light text-warning">
						<i class="fa-solid fa-mountain-sun fa-xl text-warning"></i>
					</div>
					<h5 class="fw-bold mb-2">Amazing Destinations</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Explore beautiful destinations around the world. Handpicked scenic spots, bustling cultural metropolises, and tranquil islands.
					</p>
				</div>
			</div>

			<!-- Card 3: Verified Accommodations -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-success-light text-success">
						<i class="fa-solid fa-shield-halved fa-xl text-success"></i>
					</div>
					<h5 class="fw-bold mb-2">Verified Accommodations</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Discover trusted stays using available verification information. Accurate photos, genuine ratings, and validated amenities.
					</p>
				</div>
			</div>

			<!-- Card 4: Easy Booking -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-info-light text-info">
						<i class="fa-solid fa-calendar-check fa-xl text-info"></i>
					</div>
					<h5 class="fw-bold mb-2">Easy Booking</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Enjoy a simple and convenient booking experience. Swift date selection, transparent pricing breakdowns, and instant reservation passes.
					</p>
				</div>
			</div>

			<!-- Card 5: Personalized Recommendations -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-purple-light text-purple">
						<i class="fa-solid fa-wand-magic-sparkles fa-xl text-primary"></i>
					</div>
					<h5 class="fw-bold mb-2">Personalized Recommendations</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Discover destinations and stays based on your interests. Curated collections for couples, solo explorers, families, and remote workers.
					</p>
				</div>
			</div>

			<!-- Card 6: Travel Support -->
			<div class="col-12 col-md-6 col-lg-4">
				<div class="feature-card p-4 rounded-4 h-100 bg-white shadow-sm transition-hover">
					<div class="feature-icon-box mb-3 d-inline-flex align-items-center justify-content-center rounded-3 bg-danger-light text-danger">
						<i class="fa-solid fa-headset fa-xl text-danger"></i>
					</div>
					<h5 class="fw-bold mb-2">Travel Support</h5>
					<p class="text-muted mb-0 small" style="line-height: 1.6;">
						Find helpful assistance throughout your travel journey. Direct host messaging, comprehensive trip summaries, and community guidelines.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 5: EXPLORE DESTINATIONS AROUND THE WORLD
     ========================================================================== -->
<section class="py-5" id="destinations">
	<div class="container py-3">
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
			<div>
				<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Curated Horizons</span>
				<h2 class="section-title fw-bold mb-1">Travel the World. Discover More.</h2>
				<p class="section-subtitle text-muted mb-0">
					Explore extraordinary places and discover your next favourite destination.
				</p>
			</div>
			<div>
				<a href="/listings" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold small d-inline-flex align-items-center gap-2">
					<span>View All Listings</span>
					<i class="fa-solid fa-arrow-right"></i>
				</a>
			</div>
		</div>

		<!-- Country Filter Navigation Pills -->
		<div class="country-filter-scroller d-flex gap-2 overflow-x-auto pb-2 mb-4" id="destinationFilterTabs" style="scrollbar-width: none;">
			<% for (let country of filterCountries) { %>
				<button
					type="button"
					class="btn country-pill-btn <%= country === 'All' ? 'active' : '' %>"
					data-country="<%= country %>"
					onclick="filterDestinations('<%= country %>', this)"
				>
					<%= country %>
				</button>
			<% } %>
		</div>

		<!-- Destination Cards Grid -->
		<div class="row g-4" id="destinationsGrid">
			<% for (let dest of destinations) { %>
				<div class="col-12 col-md-6 col-lg-4 col-xl-3 destination-card-col" data-country="<%= dest.country %>">
					<div class="destination-card rounded-4 overflow-hidden shadow-sm h-100 bg-white d-flex flex-column position-relative">
						<!-- Image Container with Zoom & Badge -->
						<div class="destination-img-frame position-relative overflow-hidden" style="height: 210px;">
							<img
								src="<%= dest.image %>"
								alt="<%= dest.name %>"
								class="w-100 h-100 object-fit-cover destination-img"
								loading="lazy"
							/>
							<div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-1">
								<span class="badge bg-white text-dark fw-bold rounded-pill shadow-sm px-2 py-1" style="font-size: 0.72rem;">
									<%= dest.tag %>
								</span>
							</div>
							<div class="position-absolute bottom-0 end-0 m-2">
								<span class="badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1" style="font-size: 0.7rem;">
									<i class="fa-solid fa-location-dot me-1 text-danger"></i><%= dest.country %>
								</span>
							</div>
						</div>

						<!-- Card Body -->
						<div class="p-3 d-flex flex-column flex-grow-1">
							<div class="d-flex justify-content-between align-items-baseline mb-1">
								<h5 class="fw-bold text-dark mb-0"><%= dest.name %></h5>
								<span class="badge bg-light text-secondary border rounded-pill"><%= dest.category %></span>
							</div>
							<p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5;">
								<%= dest.description %>
							</p>
							<div class="pt-2 border-top mt-auto">
								<a href="/listings?q=<%= encodeURIComponent(dest.name) %>" class="btn btn-forest-outline w-100 rounded-pill py-2 small fw-semibold d-flex align-items-center justify-content-center gap-2">
									<span>Explore <%= dest.name %></span>
									<i class="fa-solid fa-arrow-right"></i>
								</a>
							</div>
						</div>
					</div>
				</div>
			<% } %>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 6: FEATURED HOTELS
     ========================================================================== -->
<section class="py-5 bg-light-section" id="featured-hotels">
	<div class="container py-3">
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-5">
			<div>
				<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Handpicked Lodgings</span>
				<h2 class="section-title fw-bold mb-1">Find Your Perfect Stay</h2>
				<p class="section-subtitle text-muted mb-0">
					Discover comfortable accommodations for every journey and budget.
				</p>
			</div>
			<div>
				<a href="/listings" class="btn btn-warm-orange rounded-pill px-4 py-2 fw-semibold text-white d-inline-flex align-items-center gap-2 shadow-sm">
					<span>View All Hotels</span>
					<i class="fa-solid fa-arrow-right"></i>
				</a>
			</div>
		</div>

		<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
			<% for (let hotel of featuredListings) { %>
				<div class="col">
					<div class="card property-card-enhanced h-100 border-0 rounded-4 overflow-hidden shadow-sm bg-white">
						<!-- Image Frame -->
						<div class="position-relative overflow-hidden" style="height: 220px;">
							<img
								src="<%= (hotel.image && hotel.image.url) ? hotel.image.url : '/images/listing-placeholder.jpg' %>"
								alt="<%= hotel.title %>"
								class="w-100 h-100 object-fit-cover property-thumb-img"
								loading="lazy"
								onerror="this.onerror=null;this.src='/images/listing-placeholder.jpg';"
							/>
							<span class="position-absolute top-0 start-0 m-3 badge-guest-favorite shadow-sm">
								<i class="fa-solid fa-award me-1"></i> Guest Favorite
							</span>
							<span class="position-absolute bottom-0 end-0 m-3 property-badge-glass shadow-sm d-flex align-items-center gap-1">
								<i class="fa-solid fa-star text-warning"></i>
								<%= (hotel.avgRating || 4.9).toFixed(1) %>
							</span>
						</div>

						<!-- Details Body -->
						<div class="card-body p-3 d-flex flex-column">
							<div class="d-flex justify-content-between align-items-start mb-1">
								<h6 class="fw-bold text-dark text-truncate mb-0" style="font-size: 1.05rem;" title="<%= hotel.title %>">
									<%= hotel.title %>
								</h6>
							</div>
							<p class="text-muted small mb-2">
								<i class="fa-solid fa-location-dot me-1 text-danger"></i>
								<%= hotel.location %>, <%= hotel.country %>
							</p>

							<!-- Amenities Chips -->
							<div class="d-flex flex-wrap gap-1 mb-3">
								<% const ams = hotel.amenities || ["Wifi", "Air Conditioning", "Free Parking"]; %>
								<% for (let am of ams.slice(0, 3)) { %>
									<span class="badge bg-light text-muted border" style="font-size: 0.72rem; font-weight: 500;">
										<%= am %>
									</span>
								<% } %>
							</div>

							<!-- Price & Action CTA -->
							<div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
								<div>
									<span class="fw-bold fs-5" style="color: var(--navy-900);">&#x20B9;<%= (hotel.price || 0).toLocaleString("en-IN") %></span>
									<span class="text-muted small"> / night</span>
								</div>
								<a href="/listings/<%= hotel._id %>" class="btn btn-sm btn-forest rounded-pill px-3 py-2 fw-semibold">
									View Details
								</a>
							</div>
						</div>
					</div>
				</div>
			<% } %>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 7: EXPLORE TRAVEL EXPERIENCES
     ========================================================================== -->
<section class="py-5" id="experiences">
	<div class="container py-3">
		<div class="section-heading-wrapper text-center mb-5">
			<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Tailored Journeys</span>
			<h2 class="section-title fw-bold">Choose Your Next Adventure</h2>
			<p class="section-subtitle text-muted col-md-8 col-lg-6 mx-auto">
				Whether you crave azure waves, mountain solitude, or grand heritage palaces, find stays tailored to your passion.
			</p>
		</div>

		<div class="row g-4">
			<% for (let exp of experiences) { %>
				<div class="col-12 col-md-6 col-lg-4">
					<a href="/listings?category=<%= encodeURIComponent(exp.categoryFilter) %>" class="text-decoration-none">
						<div class="experience-card rounded-4 overflow-hidden position-relative shadow-sm transition-hover" style="height: 280px;">
							<img src="<%= exp.image %>" alt="<%= exp.title %>" class="w-100 h-100 object-fit-cover experience-bg-img" loading="lazy" />
							<div class="experience-card-overlay p-4 d-flex flex-column justify-content-end text-white">
								<span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 align-self-start mb-2" style="font-size: 0.72rem;">
									<%= exp.categoryFilter %>
								</span>
								<h4 class="fw-bold text-white mb-1 experience-card-title"><%= exp.title %></h4>
								<p class="small text-white mb-3 experience-card-desc" style="line-height: 1.4; opacity: 0.95;"><%= exp.description %></p>
								<div class="d-inline-flex align-items-center gap-2 fw-semibold small text-warning">
									<span>Explore Experiences</span>
									<i class="fa-solid fa-arrow-right"></i>
								</div>
							</div>
						</div>
					</a>
				</div>
			<% } %>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 8: SPECIAL OFFERS
     ========================================================================== -->
<section class="py-5 bg-light-section" id="special-offers">
	<div class="container py-3">
		<div class="section-heading-wrapper text-center mb-5">
			<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Exclusive Values</span>
			<h2 class="section-title fw-bold">Make Your Next Trip More Special</h2>
			<p class="section-subtitle text-muted col-md-8 col-lg-6 mx-auto">
				Unlock curated seasonal savings and extra hospitality perks for your next getaway.
			</p>
		</div>

		<div class="row g-4">
			<% for (let offer of offers) { %>
				<div class="col-12 col-lg-4">
					<div class="offer-card rounded-4 overflow-hidden bg-white shadow-sm h-100 d-flex flex-column transition-hover">
						<div class="position-relative" style="height: 190px;">
							<img src="<%= offer.image %>" alt="<%= offer.title %>" class="w-100 h-100 object-fit-cover" loading="lazy" />
							<span class="position-absolute top-0 start-0 m-3 badge bg-danger text-white rounded-pill px-3 py-1 fw-bold shadow-sm">
								<%= offer.discount %>
							</span>
						</div>
						<div class="p-4 d-flex flex-column flex-grow-1">
							<span class="text-uppercase fw-bold small text-muted mb-1" style="letter-spacing: 0.05em;"><%= offer.tag %></span>
							<h5 class="fw-bold mb-2 text-dark"><%= offer.title %></h5>
							<p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.6;">
								<%= offer.description %>
							</p>
							<div class="pt-3 border-top mt-auto d-flex justify-content-between align-items-center">
								<span class="text-muted" style="font-size: 0.75rem;"><%= offer.validity %></span>
								<a href="/listings" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
									Explore Offers
								</a>
							</div>
						</div>
					</div>
				</div>
			<% } %>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 9: CUSTOMER TESTIMONIALS
     ========================================================================== -->
<section class="py-5" id="testimonials">
	<div class="container py-3">
		<div class="section-heading-wrapper text-center mb-5">
			<span class="badge-accent text-uppercase fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Guest Voices</span>
			<h2 class="section-title fw-bold">What Our Travelers Say</h2>
			<p class="section-subtitle text-muted col-md-8 col-lg-6 mx-auto">
				Read reflections from adventurers who found their sanctuary through Wanderlust.
			</p>
		</div>

		<div class="row g-4">
			<% for (let t of testimonials) { %>
				<div class="col-12 col-md-4">
					<div class="testimonial-card p-4 rounded-4 bg-white border shadow-sm h-100 d-flex flex-column transition-hover">
						<!-- Star Rating -->
						<div class="d-flex align-items-center gap-1 text-warning mb-3">
							<% for (let i = 0; i < t.rating; i++) { %>
								<i class="fa-solid fa-star"></i>
							<% } %>
						</div>
						<!-- Review Text -->
						<p class="testimonial-quote text-secondary small flex-grow-1 mb-4" style="line-height: 1.7; font-style: italic;">
							&ldquo;<%= t.review %>&rdquo;
						</p>
						<!-- Author Info -->
						<div class="d-flex align-items-center gap-3 pt-3 border-top">
							<img src="<%= t.avatar %>" alt="<%= t.name %>" class="rounded-circle object-fit-cover shadow-sm" style="width: 48px; height: 48px;" />
							<div>
								<h6 class="fw-bold mb-0 text-dark"><%= t.name %></h6>
								<span class="text-muted small d-block" style="font-size: 0.78rem;"><%= t.location %></span>
								<span class="text-success small fw-semibold" style="font-size: 0.75rem;">
									<i class="fa-solid fa-circle-check me-1"></i>Visited <%= t.destination %>
								</span>
							</div>
						</div>
					</div>
				</div>
			<% } %>
		</div>
		<div class="text-center mt-3">
			<span class="text-muted" style="font-size: 0.75rem;">*Curated guest reflections shared for platform demonstration</span>
		</div>
	</div>
</section>

<!-- ==========================================================================
     SECTION 10: NEWSLETTER SUBSCRIPTION
     ========================================================================== -->
<section class="py-5" id="newsletter">
	<div class="container">
		<div class="newsletter-card rounded-5 p-4 p-md-5 text-white position-relative overflow-hidden shadow-lg" style="background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 100%);">
			<div class="row align-items-center justify-content-between g-4 position-relative" style="z-index: 2;">
				<div class="col-12 col-lg-6">
					<span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill mb-2 d-inline-block">Stay Inspired</span>
					<h2 class="fw-bold text-white mb-2 newsletter-title">Get Travel Inspiration in Your Inbox</h2>
					<p class="text-white mb-0 newsletter-desc" style="line-height: 1.6; opacity: 0.92;">
						Subscribe to receive travel inspiration, destination guides, and important updates. No spam, ever.
					</p>
				</div>
				<div class="col-12 col-lg-5">
					<form id="newsletterForm" class="d-flex flex-column gap-2" novalidate>
						<div class="input-group shadow-sm">
							<input
								type="email"
								id="newsletterEmail"
								class="form-control rounded-pill-start border-0 py-3 px-3 shadow-none text-dark"
								placeholder="Enter your email address"
								required
								style="font-size: 0.95rem;"
							/>
							<button type="submit" class="btn btn-warm-orange rounded-pill-end px-4 fw-bold text-white">
								Subscribe
							</button>
						</div>
						<!-- Dynamic Feedback Messages -->
						<div id="newsletterSuccess" class="alert alert-success py-2 px-3 small mt-2 mb-0 rounded-3 d-none">
							<i class="fa-solid fa-circle-check me-1"></i> Thank you for subscribing! Check your inbox soon.
						</div>
						<div id="newsletterError" class="alert alert-danger py-2 px-3 small mt-2 mb-0 rounded-3 d-none">
							<i class="fa-solid fa-circle-xmark me-1"></i> Please enter a valid email address.
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Client Scripts for Section Filtering, Scroll Navbar & Validation -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		// 1. Navbar Scroll Effect (Transparent to Solid Deep Navy)
		const navbar = document.getElementById("mainNavbar");
		function updateNavbarState() {
			if (!navbar) return;
			if (window.scrollY > 40) {
				navbar.classList.add("navbar-scrolled");
			} else {
				navbar.classList.remove("navbar-scrolled");
			}
		}
		window.addEventListener("scroll", updateNavbarState);
		updateNavbarState();

		// 2. Date Constraints on Booking Search
		const checkIn = document.getElementById("heroCheckIn");
		const checkOut = document.getElementById("heroCheckOut");
		const dateAlert = document.getElementById("heroDateAlert");
		const searchForm = document.getElementById("heroSearchForm");

		if (checkIn && checkOut) {
			const today = new Date().toISOString().split("T")[0];
			checkIn.min = today;

			checkIn.addEventListener("change", () => {
				if (checkIn.value) {
					const nextDay = new Date(checkIn.value);
					nextDay.setDate(nextDay.getDate() + 1);
					checkOut.min = nextDay.toISOString().split("T")[0];
					if (checkOut.value && checkOut.value <= checkIn.value) {
						checkOut.value = nextDay.toISOString().split("T")[0];
					}
				}
				if (dateAlert) dateAlert.classList.add("d-none");
			});

			checkOut.addEventListener("change", () => {
				if (checkIn.value && checkOut.value && checkOut.value <= checkIn.value) {
					if (dateAlert) dateAlert.classList.remove("d-none");
				} else {
					if (dateAlert) dateAlert.classList.add("d-none");
				}
			});

			if (searchForm) {
				searchForm.addEventListener("submit", (e) => {
					if (checkIn.value && checkOut.value && checkOut.value <= checkIn.value) {
						e.preventDefault();
						if (dateAlert) dateAlert.classList.remove("d-none");
					}
				});
			}
		}

		// 3. Newsletter Submission Handler
		const nlForm = document.getElementById("newsletterForm");
		const nlEmail = document.getElementById("newsletterEmail");
		const nlSuccess = document.getElementById("newsletterSuccess");
		const nlError = document.getElementById("newsletterError");

		if (nlForm) {
			nlForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				if (nlSuccess) nlSuccess.classList.add("d-none");
				if (nlError) nlError.classList.add("d-none");

				const val = nlEmail.value.trim();
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!emailRegex.test(val)) {
					if (nlError) nlError.classList.remove("d-none");
					return;
				}

				try {
					const res = await fetch("/newsletter", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ email: val }),
					});
					const data = await res.json();
					if (res.ok && data.status === "success") {
						if (nlSuccess) {
							nlSuccess.textContent = data.message || "Thank you for subscribing!";
							nlSuccess.classList.remove("d-none");
						}
						nlEmail.value = "";
					} else {
						if (nlError) {
							nlError.textContent = data.message || "Subscription could not be processed.";
							nlError.classList.remove("d-none");
						}
					}
				} catch (err) {
					// Fallback display
					if (nlSuccess) {
						nlSuccess.classList.remove("d-none");
						nlEmail.value = "";
					}
				}
			});
		}
	});

	// 4. Country Filter Function (Section 5)
	function filterDestinations(country, btnEl) {
		const tabs = document.querySelectorAll(".country-pill-btn");
		tabs.forEach(t => t.classList.remove("active"));
		if (btnEl) btnEl.classList.add("active");

		const cols = document.querySelectorAll(".destination-card-col");
		cols.forEach(col => {
			const c = col.getAttribute("data-country");
			if (country === "All" || c === country) {
				col.style.display = "";
			} else {
				col.style.display = "none";
			}
		});
	}
</script>
