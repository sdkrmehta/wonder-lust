<% layout("layouts/boilerplate") %>

<div class="container-standard my-4 my-md-5">
	<!-- Breadcrumb Navigation -->
	<nav aria-label="breadcrumb" class="mb-3">
		<ol class="breadcrumb small">
			<li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-forest">Home</a></li>
			<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Terms of Service</li>
		</ol>
	</nav>

	<!-- Header Banner -->
	<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
		<div class="d-flex flex-column gap-2">
			<span class="badge rounded-pill bg-light text-forest border px-3 py-1 small fw-semibold align-self-start">
				<i class="fa-solid fa-scale-balanced me-1"></i> Marketplace Agreement
			</span>
			<h1 class="editorial-title display-6 fw-bold text-dark mb-1">
				Terms of Service
			</h1>
			<p class="text-muted small mb-0">
				Last updated: November 2026 &bull; Rules, Responsibilities, and Community Standards for Travelers and Hosts.
			</p>
		</div>
	</div>

	<!-- Content Layout with Sticky Quick-Nav -->
	<div class="row g-4">
		<!-- Sidebar Navigation -->
		<div class="col-12 col-lg-4 d-none d-lg-block">
			<div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
				<h6 class="fw-bold text-dark mb-3 text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 0.05em;">
					Table of Contents
				</h6>
				<nav class="nav flex-column gap-2 small">
					<a class="nav-link text-forest py-1 px-2 rounded-2 bg-light-subtle fw-semibold" href="#section-1">1. Acceptance of Terms</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-2">2. Marketplace &amp; Host Responsibilities</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-3">3. Booking, Payments &amp; Invoices</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-4">4. Cancellations &amp; Guest Refunds</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-5">5. User Conduct &amp; Safety</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-6">6. Reviews &amp; Moderation</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-7">7. Limitation of Liability</a>
				</nav>
			</div>
		</div>

		<!-- Main Legal Content -->
		<div class="col-12 col-lg-8">
			<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
				<!-- Section 1 -->
				<section id="section-1" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">1. Acceptance of Terms</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						By accessing or using Wonder-Lust, you agree to be bound by these Terms of Service and all applicable laws and regulations.
					</p>
					<p class="text-secondary small leading-relaxed mb-0">
						If you do not agree with any of these terms, you are prohibited from using or accessing this marketplace, making property reservations, or publishing listings.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 2 -->
				<section id="section-2" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">2. Marketplace &amp; Host Responsibilities</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						Hosts are solely responsible for ensuring that property listings are accurate, available, and comply with all applicable local zoning and housing laws.
					</p>
					<ul class="text-secondary small ps-3 mb-0">
						<li class="mb-2"><strong>Listing Accuracy:</strong> Property descriptions, photographs, amenities checklists, and nightly tariffs must genuinely reflect the current state of the rental property.</li>
						<li class="mb-2"><strong>Permits &amp; Authorizations:</strong> Hosts confirm they hold the legal authority, lease rights, and regulatory registrations required to offer accommodation in their jurisdiction.</li>
						<li><strong>Hospitality Standards:</strong> Properties must maintain cleanliness, safe access, active utilities, and timely communication with confirmed guests.</li>
					</ul>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 3 -->
				<section id="section-3" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">3. Booking, Payments &amp; Invoices</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						When a guest books a stay, the reservation is subject to instant date verification and payment authorization.
					</p>
					<div class="p-3 rounded-3 border-start border-4 border-forest mb-0" style="background-color: var(--forest-100);">
						<div class="d-flex align-items-center gap-2 mb-1">
							<i class="fa-solid fa-receipt text-forest"></i>
							<strong class="text-forest small">Statutory GST &amp; Invoicing</strong>
						</div>
						<p class="text-secondary small mb-0">
							In accordance with statutory tax regulations, all reservations include an itemized breakdown of base tariffs, mandatory cleaning fees, and 18% GST (9% CGST + 9% SGST) categorized under HSN/SAC code 996311. Official tax receipts are downloadable immediately following payment confirmation.
						</p>
					</div>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 4 -->
				<section id="section-4" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">4. Cancellations &amp; Guest Refunds</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						Guests may initiate cancellations directly through their booking itinerary. Refund eligibility is determined transparently based on the notice period provided prior to the scheduled check-in date. Confirmed refunds are credited back to the original source payment instrument.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 5 -->
				<section id="section-5" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">5. User Conduct</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						Users agree not to engage in fraudulent bookings, post abusive reviews, or attempt to circumvent application security or access controls.
					</p>
					<p class="text-secondary small leading-relaxed mb-0">
						Wonder-Lust reserves the right to suspend or ban accounts that exhibit malicious behaviors, spam messaging, unauthorized data scraping, or harassment of hosts and travelers.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 6 -->
				<section id="section-6" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">6. Reviews &amp; Moderation</h3>
					<p class="text-secondary small leading-relaxed mb-0">
						Registered travelers (excluding the property owner) may submit reviews and multi-dimensional ratings. Reviews from travelers with a confirmed or completed reservation on the property are automatically verified and marked with a Verified Stay badge, while stricter stay-only gating may be enforced per marketplace policy. Flagged reviews are placed into the administrative moderation queue for factual review and policy enforcement.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 7 -->
				<section id="section-7">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">7. Limitation of Liability</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						Wonder-Lust provides the platform "as is" and is not liable for indirect, incidental, or consequential damages resulting from platform use.
					</p>
					<p class="text-secondary small leading-relaxed mb-0">
						Wonder-Lust acts as a technology intermediary connecting independent property hosts with discerning travelers, and does not own or operate the real estate properties listed on the service.
					</p>
				</section>
			</div>
		</div>
	</div>
</div>
