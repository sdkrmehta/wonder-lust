<% layout("layouts/boilerplate") %>

<div class="container-standard my-4 my-md-5">
	<!-- Breadcrumb Navigation -->
	<nav aria-label="breadcrumb" class="mb-3">
		<ol class="breadcrumb small">
			<li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-forest">Home</a></li>
			<li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Privacy Policy</li>
		</ol>
	</nav>

	<!-- Header Banner -->
	<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
		<div class="d-flex flex-column gap-2">
			<span class="badge rounded-pill bg-light text-forest border px-3 py-1 small fw-semibold align-self-start">
				<i class="fa-solid fa-shield-halved me-1"></i> Data Protection &amp; Trust
			</span>
			<h1 class="editorial-title display-6 fw-bold text-dark mb-1">
				Privacy Policy
			</h1>
			<p class="text-muted small mb-0">
				Last updated: November 2026 &bull; Wander-Lust Global Hospitality Standards &bull; Effective for all registered travelers and hosts.
			</p>
		</div>
	</div>

	<!-- Content Layout with Sticky Quick-Nav -->
	<div class="row g-4">
		<!-- Sidebar Navigation -->
		<div class="col-12 col-lg-4 d-none d-lg-block">
			<div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
				<h6 class="fw-bold text-dark mb-3 text-uppercase tracking-wider" style="font-size: 0.75rem; letter-spacing: 0.05em;">
					Table of Contents
				</h6>
				<nav class="nav flex-column gap-2 small">
					<a class="nav-link text-forest py-1 px-2 rounded-2 bg-light-subtle fw-semibold" href="#section-1">1. Information We Collect</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-2">2. How We Use Information</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-3">3. Data Security &amp; Encryption</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-4">4. Payment &amp; Financial Security</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-5">5. Cookies &amp; Local Storage</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-6">6. Your Rights &amp; Choices</a>
					<a class="nav-link text-muted py-1 px-2 rounded-2" href="#section-7">7. Contact Concierge</a>
				</nav>
			</div>
		</div>

		<!-- Main Legal Content -->
		<div class="col-12 col-lg-8">
			<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
				<!-- Section 1 -->
				<section id="section-1" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">1. Information We Collect</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						Wander-Lust collects information you provide directly to us when creating an account, updating your profile, listing a property, or submitting a review. This includes:
					</p>
					<ul class="text-secondary small ps-3 mb-3">
						<li class="mb-2"><strong>Identity &amp; Contact Information:</strong> Full name, verified email address, phone number, physical address, and avatar imagery.</li>
						<li class="mb-2"><strong>Property &amp; Hosting Information:</strong> Property titles, physical location coordinates, pricing per night, bedroom configurations, and high-resolution photo galleries.</li>
						<li class="mb-2"><strong>Transaction &amp; Reservation Records:</strong> Check-in and check-out dates, guest counts, payment orders, and digital tax invoice identifiers.</li>
						<li><strong>Communication Records:</strong> Direct traveler-host messaging threads, inquiry messages, and ratings with review commentary.</li>
					</ul>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 2 -->
				<section id="section-2" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">2. How We Use Information</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						We use the information to operate, maintain, and improve our vacation rental marketplace, facilitate bookings, authenticate users, and communicate with you. Specifically, we utilize your data to:
					</p>
					<div class="row g-3">
						<div class="col-12 col-sm-6">
							<div class="p-3 rounded-3 h-100" style="background-color: var(--paper-100);">
								<h6 class="fw-bold text-dark small mb-1"><i class="fa-solid fa-calendar-check text-forest me-2"></i>Reservation Fulfillment</h6>
								<p class="text-muted small mb-0">Confirm stays, check real-time date conflicts, and coordinate check-in details between hosts and guests.</p>
							</div>
						</div>
						<div class="col-12 col-sm-6">
							<div class="p-3 rounded-3 h-100" style="background-color: var(--paper-100);">
								<h6 class="fw-bold text-dark small mb-1"><i class="fa-solid fa-shield-halved text-terracotta me-2"></i>Trust &amp; Safety</h6>
								<p class="text-muted small mb-0">Prevent duplicate registrations, detect bot traffic, and screen reviews for policy compliance.</p>
							</div>
						</div>
					</div>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 3 -->
				<section id="section-3" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">3. Data Security</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						We implement industry-standard security measures including encrypted session stores and salted password hashes to safeguard your personal information.
					</p>
					<div class="p-3 rounded-3 border-start border-4 border-forest mb-3" style="background-color: var(--forest-100);">
						<div class="d-flex align-items-center gap-2 mb-1">
							<i class="fa-solid fa-lock text-forest"></i>
							<strong class="text-forest small">Architectural Security Protections</strong>
						</div>
						<p class="text-secondary small mb-0">
							Authentication passwords are cryptographically salted and hashed using standard bcrypt hashing. Web sessions use cryptographically signed HTTP-only cookies protected against cross-site scripting (XSS) and injection attacks.
						</p>
					</div>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 4 -->
				<section id="section-4" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">4. Payment &amp; Financial Security</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						All payment transactions, credit/debit card processing, UPI handle transfers, and NetBanking authorizations are executed through secure, tokenized payment gateways. Wander-Lust never stores unencrypted primary account numbers (PANs) or card CVV verification codes on its application servers.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 5 -->
				<section id="section-5" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">5. Cookies &amp; Local Storage</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						We use strictly necessary session cookies to maintain your authenticated login state, CSRF tokens to safeguard against forged transactions, and lightweight preferences for tax calculations and category browsing filters.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 6 -->
				<section id="section-6" class="mb-5">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">6. Your Rights &amp; Choices</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						You maintain total control over your profile and hosting credentials. You may review, modify, or update your personal information at any time via <a href="/profile/edit" class="text-forest text-decoration-none fw-semibold">Profile Settings</a>.
					</p>
				</section>

				<hr class="my-4 text-muted opacity-25" />

				<!-- Section 7 -->
				<section id="section-7">
					<h3 class="editorial-title h4 fw-bold text-dark mb-3">7. Contact Us</h3>
					<p class="text-secondary small leading-relaxed mb-3">
						If you have any questions about this Privacy Policy, please contact privacy@wanderlust.local.
					</p>
					<div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background-color: var(--paper-100);">
						<div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background-color: var(--forest-800);">
							<i class="fa-solid fa-envelope"></i>
						</div>
						<div>
							<div class="fw-bold text-dark small">Data Privacy &amp; Trust Officer</div>
							<div class="text-muted small">privacy@wanderlust.local &bull; Concierge Desk, Wander-Lust HQ</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</div>
</div>
