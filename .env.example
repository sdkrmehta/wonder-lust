# ------------------------------------------------------------------------------
# 1. APPLICATION CORE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment: "development", "staging", "test", or "production"
NODE_ENV=development

# Port where Express HTTP server listens
PORT=8080

# Application display name and public URL
APP_NAME=Wander-Lust
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# Local MongoDB instance or MongoDB Atlas Connection URI
# Format: mongodb://<user>:<password>@<host>:<port>/<database>?<options>
DB_URL=mongodb://localhost:27017/wonderlust

# Backward-compatibility alias for MongoDB URI
ATLASDB_URL=mongodb://localhost:27017/wonderlust
MONGO_URL=mongodb://localhost:27017/wonderlust

# Maximum connection pool size (default: 10)
DB_POOL_SIZE=10

# ------------------------------------------------------------------------------
# 3. HTTP SESSION & COOKIE SECURITY
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for express-session signature
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=super_secret_session_key_replace_with_64_char_hex_for_production
SECRET=super_secret_session_key_replace_with_64_char_hex_for_production

# Session cookie name (default: "wanderlust.sid")
SESSION_NAME=wanderlust.sid

# Session validity duration in days (default: 7)
SESSION_MAX_AGE_DAYS=7

# Enforce secure cookies (Requires HTTPS in production; set to true in production)
COOKIE_SECURE=true
TRUST_PROXY=1

# Allowed Cross-Origin Resource Sharing (CORS) origins (comma-separated)
CORS_ORIGIN=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. RATE LIMITING & DDOS PROTECTION
# ------------------------------------------------------------------------------
# Sliding window in milliseconds (default: 15 minutes = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window on general API routes (/api/v1/*)
RATE_LIMIT_MAX_API=500

# Max attempts per window on sensitive authentication routes (/login, /signup)
RATE_LIMIT_MAX_AUTH=20

# ------------------------------------------------------------------------------
# 4B. PRODUCTION DATABASE TLS, PAYMENTS & DIAGNOSTIC HARDENING
# ------------------------------------------------------------------------------
# Require TLS for MongoDB connections in production (true by default in NODE_ENV=production)
MONGO_REQUIRE_TLS=true

# Payment processing mode ("strict" in production requires signed webhook verification; "sandbox" in dev/test)
PAYMENT_GATEWAY_MODE=strict

# HMAC-SHA256 webhook verification secret (>= 32 chars required in strict/production mode)
PAYMENT_WEBHOOK_SECRET=replace_with_a_64_char_random_webhook_signing_secret

# Require completed confirmed booking before allowing listing reviews (true/false)
REQUIRE_VERIFIED_STAY_REVIEWS=true

# Optional shared token allowing authenticated access to detailed /health and /ready probes via X-Health-Token
HEALTH_CHECK_TOKEN=replace_with_a_random_health_probe_token

# ------------------------------------------------------------------------------
# 5. CLOUD MEDIA & IMAGE PIPELINE (CLOUDINARY)
# ------------------------------------------------------------------------------
# Optional Cloudinary cloud storage credentials for production media hosting.
# When omitted, the platform automatically uses local disk storage (/uploads).
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Upload storage backend: "local" or "cloudinary"
UPLOAD_STORAGE=local

# Maximum allowable upload size in megabytes (default: 5MB)
MAX_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 6. BILLING, TAX & INVOICE SETTINGS
# ------------------------------------------------------------------------------
# Services Accounting Code for Accommodation / Vacation Rental Services
TAX_SAC_CODE=996311

# Goods & Services Tax (GST) rate in percent (default: 18%)
GST_PERCENTAGE=18

# Fixed cleaning fee applied per reservation in INR (default: 500)
CLEANING_FEE_INR=500

# Marketplace platform take-rate percentage deducted from host payout (default: 10%)
PLATFORM_FEE_PERCENTAGE=10

# ------------------------------------------------------------------------------
# 7. MAPS & GEOLOCATION
# ------------------------------------------------------------------------------
# Public geocoding / map tiles API key (Mapbox / OpenStreetMap tile provider)
MAP_API_KEY=your_map_provider_key

# ------------------------------------------------------------------------------
# 8. PROCESS MANAGEMENT & ETL (OPTIONAL)
# ------------------------------------------------------------------------------
# Number of cluster instances for PM2 ("max" or integer)
PM2_INSTANCES=max

# Custom directory containing raw ETL CSV files (default: "./dataset")
DATASET_DIR=./dataset

